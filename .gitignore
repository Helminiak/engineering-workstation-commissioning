# Explicitly version sanitized commissioning sources only.
/*
!/.gitignore
!/commissioning/
!/scripts/
!/tests/
!/handoff/
!/reports/
!/configs/
!/tools/
/tools/*
!/tools/commissioning*
!/tools/workbench_mcp.py
commissioning/.runner.lock
**/__pycache__/
**/*.pyc
reports/*raw*

# Multi-LLM source-control hygiene (additive; existing exclusions retained)
.env
.env.*
!.env.example
*.key
*.pem
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
build/
dist/
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
model-weights/
models/cache/
*.gguf
*.safetensors

# Permit governance under the existing root allowlist
!/README.md
!/AGENTS.md
!/SECURITY.md
!/docs/
!/.ai/
!/.github/
