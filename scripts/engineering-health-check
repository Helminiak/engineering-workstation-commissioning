#!/usr/bin/env python3
"""Non-destructive verification; no repairs. 0 pass, 1 fail, 2 incomplete, 3 checker error."""

import argparse
import asyncio
import datetime
import json
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


async def mcp_check():
    from mcp import ClientSession, StdioServerParameters
    from mcp.client.stdio import stdio_client

    async with asyncio.timeout(15):
        async with (
            stdio_client(
                StdioServerParameters(
                    command=str(ROOT / ".venv/bin/python"),
                    args=[str(ROOT / "tools/workbench_mcp.py")],
                )
            ) as streams,
            ClientSession(*streams) as c,
        ):
            await c.initialize()
            x = await c.list_tools()
            names = [t.name for t in x.tools]
            assert "run_command" in names and "run_python" in names
            return names


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--json", type=Path)
    a = ap.parse_args()
    checks = {}

    def cmd(name, argv, required=True):
        if not shutil.which(argv[0]):
            checks[name] = {
                "status": "NOT_TESTED",
                "reason": "Executable absent",
                "required": required,
            }
            return
        p = subprocess.run(
            argv, cwd=ROOT, capture_output=True, text=True, timeout=30, check=False
        )
        checks[name] = {
            "status": "PASS"
            if p.returncode == 0
            else ("FAIL" if required else "MANUAL_REQUIRED"),
            "exit_code": p.returncode,
            "stdout": "\n".join(
                line
                for line in p.stdout.splitlines()
                if not line.lstrip().startswith("- Token:")
            )[:4000],
            "stderr": "\n".join(
                line
                for line in p.stderr.splitlines()
                if not line.lstrip().startswith("- Token:")
            )[:1000],
            "required": required,
        }

    cmd(
        "GPU",
        [
            "nvidia-smi",
            "--query-gpu=name,driver_version,memory.used,memory.total,temperature.gpu",
            "--format=csv,noheader",
        ],
    )
    checks["disk_headroom"] = {
        "status": "PASS" if shutil.disk_usage(ROOT).free > 10 * 1024**3 else "FAIL",
        "required": True,
    }
    cmd("disk", ["df", "-h", str(ROOT)])
    cmd("memory", ["free", "-h"])
    memory_values = {
        line.split(":")[0]: int(line.split()[1])
        for line in Path("/proc/meminfo").read_text().splitlines()
    }
    checks["memory_headroom"] = {
        "status": "PASS"
        if memory_values["MemAvailable"] >= 2 * 1024 * 1024
        else "FAIL",
        "available_kib": memory_values["MemAvailable"],
        "required": True,
    }
    cmd(
        "quant_packages",
        [
            str(ROOT / "venvs/quant/bin/python"),
            "-c",
            'import numpy, scipy, pandas, polars, pyarrow, duckdb, statsmodels, sklearn, numba, pytest; print("critical quant imports pass")',
        ],
    )
    cmd(
        "quant_dependencies",
        ["uv", "pip", "check", "--python", str(ROOT / "venvs/quant/bin/python")],
    )
    cmd(
        "gpu_dependencies",
        ["uv", "pip", "check", "--python", str(ROOT / "venvs/gpu/bin/python")],
    )
    cmd("Python", ["python3", "--version"])
    cmd("Node", ["node", "--version"])
    cmd("npm", ["npm", "--version"])
    cmd("npx", ["npx", "--version"])
    cmd("Git", ["git", "--version"])
    cmd("GitHub", ["gh", "auth", "status"], False)
    cmd("Java", ["java", "-version"])
    cmd("LM_Studio", ["lms", "ps"])
    cmd(
        "dependencies",
        ["uv", "pip", "check", "--python", str(ROOT / ".venv/bin/python")],
    )
    checks["workspace"] = {
        "status": "PASS"
        if ROOT.is_dir() and (ROOT / "commissioning/progress.json").is_file()
        else "FAIL",
        "required": True,
    }
    cmd(
        "CUDA_PyTorch",
        [
            str(ROOT / "venvs/gpu/bin/python"),
            "-c",
            'import torch; assert torch.cuda.is_available(); x=torch.arange(10.,device="cuda"); assert x.square().sum().cpu().item()==285; print(torch.__version__,torch.cuda.get_device_name(0))',
        ],
    )
    try:
        key = (
            Path("/home/joe/.lmstudio/credentials/local-work-api.token")
            .read_text()
            .strip()
        )
        req = urllib.request.Request(
            "http://127.0.0.1:1234/api/v1/models",
            headers={"Authorization": "Bearer " + key},
        )
        with urllib.request.urlopen(req, timeout=10) as f:
            json.load(f)
        info = subprocess.run(
            ["node", "scripts/model-info.cjs"],
            cwd=ROOT,
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
        instances = json.loads(info.stdout) if info.returncode == 0 else []
        checks["local_model_API"] = {
            "status": "PASS" if instances else "NOT_TESTED",
            "loaded_instances": instances,
            "registry_limitations": "Native REST loaded_instances disagrees with CLI/SDK for SDK-loaded variant; SDK authoritative for allocation, inference tested separately.",
            "required": True,
        }
    except Exception as e:  # noqa: BLE001 -- convert subsystem failures to recorded status
        checks["local_model_API"] = {
            "status": "FAIL",
            "error_type": type(e).__name__,
            "required": True,
        }
    try:
        if sys.executable != str(ROOT / ".venv/bin/python"):
            result = subprocess.run(
                [
                    str(ROOT / ".venv/bin/python"),
                    "-c",
                    'import runpy,asyncio,json; m=runpy.run_path("scripts/engineering-health-check"); print(json.dumps(asyncio.run(m["mcp_check"]())))',
                ],
                cwd=ROOT,
                capture_output=True,
                text=True,
                timeout=20,
                check=False,
            )
            assert result.returncode == 0, result.stderr
            names = json.loads(result.stdout)
        else:
            names = asyncio.run(mcp_check())
        checks["MCP_core"] = {"status": "PASS", "tools": names, "required": True}
    except Exception as e:  # noqa: BLE001 -- convert subsystem failures to recorded status
        checks["MCP_core"] = {
            "status": "FAIL",
            "error_type": type(e).__name__,
            "required": True,
        }
    # Missing CUDA package is incomplete, not a broken installed runtime.
    if "ModuleNotFoundError" in checks["CUDA_PyTorch"].get("stderr", ""):
        checks["CUDA_PyTorch"]["status"] = "NOT_TESTED"
    result = {
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "checks": checks,
    }
    code = (
        1
        if any(v["status"] == "FAIL" and v.get("required") for v in checks.values())
        else (2 if any(v["status"] != "PASS" for v in checks.values()) else 0)
    )
    result["exit_code"] = code
    if a.json:
        a.json.write_text(json.dumps(result, indent=2) + "\n")
    for k, v in checks.items():
        print(f"{k}: {v['status']}")
    print("Exit:", code)
    return code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # noqa: BLE001 -- convert subsystem failures to recorded status
        print("Checker failure:", type(e).__name__, file=sys.stderr)
        sys.exit(3)
